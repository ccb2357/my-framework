{
  "name": "pwa-framework-admin",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --outDir .dist-build && node scripts/publish-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "check:build": "node scripts/check-build.mjs",
    "test": "vitest run",
    "lint": "eslint . && npm run lint:shared",
    "check": "npm run lint && npm test && npm run build",
    "lint:shared": "node ../shared/scripts/lint.mjs"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "imask": "7.6.1",
    "just-validate": "4.3.0",
    "lucide": "1.72.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.4",
    "vitest": "5.1.0"
  }
}
