# Gerado pelo bootstrap a partir de ../.env.foundation. Não editar valores compartilhados aqui.
APP_NAME="My Framework"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://my-framework.localhost
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=UTC
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=my_framework
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=my_framework_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=my-framework.localhost,localhost:5180,localhost:5181
CACHE_STORE=file
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
MAIL_MAILER=array
FOUNDATION_MAIN_DATABASE=my_framework
FOUNDATION_TEST_DATABASE=my_framework_test
FOUNDATION_ENV=local


# Derivados pelo bootstrap; não preencher manualmente.
ADMIN_URL=http://admin.my-framework.localhost
ADMIN_STATEFUL_DOMAINS=admin.my-framework.localhost,localhost:5182,localhost:5183
