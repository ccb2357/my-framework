# Identidade: slug deve corresponder ao nome da pasta clonada
PROJECT_SLUG=my-framework
PROJECT_NAME="My Framework"
APP_ENV=local

# Caminhos relativos à raiz do projeto e infraestrutura compartilhada
INFRA_COMPOSE_PATH=../infra/docker-compose.yml
CONTAINER_PROJECTS_ROOT=/var/www
DOCKER_NETWORK=infra_network
PHP_SERVICE=php-fpm
NGINX_SERVICE=nginx
NGINX_INTERNAL_URL=http://nginx
# Certificado compartilhado em /etc/letsencrypt/live/<nome>; vazio usa cada host
NGINX_CERT_NAME=

# Acesso PWA local e produção
PWA_LOCAL_DOMAIN=my-framework.localhost
PWA_DEV_PORT=5180
PWA_PREVIEW_PORT=5181
PWA_PRODUCTION_URL=

# Admin sempre incluído; domínios vazios derivam admin.<domínio da PWA>
ADMIN_LOCAL_DOMAIN=
ADMIN_PRODUCTION_URL=
ADMIN_DEV_PORT=5182
ADMIN_PREVIEW_PORT=5183

# Website Nuxt: domínio independente, sem mudar os endereços já instalados
WEBSITE_LOCAL_DOMAIN=website.my-framework.localhost
WEBSITE_PRODUCTION_URL=
WEBSITE_DEV_PORT=5184
# Vazio deriva o domínio comum da PWA e do website
CLIENT_SESSION_DOMAIN=

# MySQL: usar exatamente a conta existente informada
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=my_framework
DB_TEST_DATABASE=my_framework_test
DB_USERNAME=root
DB_PASSWORD=""

# Regionalização e sessão
APP_LOCALE=pt_BR
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=America/Sao_Paulo
SESSION_LIFETIME=120

# Identidade pública da PWA
PWA_SHORT_NAME="My Framework"
PWA_DESCRIPTION="Descrição do aplicativo"
PWA_THEME_COLOR="#007aff"
PWA_BACKGROUND_COLOR="#ffffff"

# Recuperação de senha por SMTP (host vazio desabilita envio)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SCHEME=smtp
SMTP_USER=seu-email@gmail.com
SMTP_PASS="senha_de_app_do_google"
SMTP_FROM_ADDRESS=seu-email@gmail.com
SMTP_FROM_NAME="Nome do aplicativo"
