{
  "name": "pwa-framework-website",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test": "node --test tests/server.test.mjs tests/session.test.mjs tests/content.test.mjs && vitest run --config vitest.config.js",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "lucide": "1.72.0",
    "reka-ui": "2.11.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "imask": "7.6.1",
    "just-validate": "4.3.0",
    "@vueuse/core": "15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "@vitejs/plugin-vue": "6.0.11",
    "jsdom": "26.1.0",
    "vitest": "5.1.0"
  }
}
